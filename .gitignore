# KiCad backup files
*-backups/
*.bak
*~

# KiCad autosave files
_autosave-*
\#auto_saved_files#

# KiCad lock files
*.lck

# KiCad local settings (user-specific)
*.kicad_prl
fp-info-cache

# Netlist files (generated)
*.net

# Gerber/fabrication outputs (regenerate from source)
# Uncomment the next line if you want to ignore generated outputs:
# output/

# OS files
Thumbs.db
.DS_Store
*.history

# STM32CubeMX safety backups
*.ioc.LOCAL_BACKUP
*.ioc.BACKUP

# Firmware build outputs (regenerate via CMake)
Software/STMCubeV2/*/build/

# Claude Code local state
.claude/
